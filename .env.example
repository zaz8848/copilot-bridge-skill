# =============================================================================
# copilot-bridge - .env
#
# 这个文件存放 **敏感凭据**（飞书 App Secret 等），由 copilot-bridge.config.json
# 通过 "${env:XXX}" 模板引用。
#
# 安全规则：
# - 本文件必须在 .gitignore 里（默认已加）
# - 别人不能用你的凭据；每个人必须自建飞书应用
# =============================================================================

# 飞书 App Secret（必填）
FEISHU_APP_SECRET=

# 飞书 App ID（可选；通常写在 config.json 里）
FEISHU_APP_ID=

# 飞书目标 chat_id（可选；通常写在 config.json 里）
FEISHU_TARGET_CHAT_ID=

# 飞书 Verification Token（可选）
FEISHU_VERIFICATION_TOKEN=

# 飞书 Encrypt Key（必须留空，本项目不支持加密回调）
FEISHU_ENCRYPT_KEY=
